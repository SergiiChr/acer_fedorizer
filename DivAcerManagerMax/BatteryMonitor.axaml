<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DivAcerManagerMax.BatteryMonitor">
    <Border Classes="Card">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="40" Margin="0,12">
            <StackPanel Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Charge level" Opacity="0.7" HorizontalAlignment="Center" />
                <TextBlock x:Name="ChargePercentage" Text="N/A" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                <ProgressBar x:Name="ChargeBar" Maximum="100" Height="16" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Status" Opacity="0.7" />
                <TextBlock x:Name="ChargeStatus" Text="N/A" FontWeight="SemiBold" />
                <TextBlock Text="Estimated time" Opacity="0.7" />
                <TextBlock x:Name="ChargeTime" Text="N/A" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
