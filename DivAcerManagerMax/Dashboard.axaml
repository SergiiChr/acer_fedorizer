<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DivAcerManagerMax.Dashboard"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:divAcerManagerMax="clr-namespace:DivAcerManagerMax"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="divAcerManagerMax:Dashboard">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">
            <Border x:Name="CpuTile" Classes="Card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="CPU" Classes="SubHeader" />
                        <material:MaterialIcon Grid.Column="1" Kind="Cpu64Bit" Width="24" Height="24" />
                    </Grid>
                    <TextBlock x:Name="CpuModel" Text="{Binding CpuName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Temperature" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C'}" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Value="{Binding CpuTemp}" Maximum="110" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Usage" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuUsage, StringFormat='{}{0:F1}%'}" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Value="{Binding CpuUsage}" Maximum="100" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Frequency by physical core" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="GHz · average of each core's logical threads" Opacity="0.7" />
                    <avalonia:CartesianChart x:Name="FrequencyChart" Height="200" />
                </StackPanel>
            </Border>
            <Border x:Name="GpuTile" Classes="Card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="GPU" Classes="SubHeader" />
                        <CheckBox Grid.Column="1" x:Name="EnableGpuMonitoring" Content="Monitor GPU" IsChecked="False"
                                  ToolTip.Tip="Live readings may keep the NVIDIA GPU awake. Leave this off to let it sleep when idle." />
                        <material:MaterialIcon Grid.Column="2" Kind="Gpu" Width="24" Height="24" />
                    </Grid>
                    <TextBlock x:Name="GpuModel" Text="{Binding GpuName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Temperature" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuTemperatureDisplay}" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Value="{Binding GpuTemp}" Maximum="110" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Usage" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuUsageDisplay}" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Value="{Binding GpuUsage}" Maximum="100" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="VRAM" Opacity="0.7" />
                                <TextBlock Grid.Column="1" x:Name="VramSummary" Text="Paused" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="VramUsageBar" Maximum="100" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Power draw" Opacity="0.7" />
                        <TextBlock x:Name="GpuPower" Text="Paused" FontWeight="SemiBold"
                                   ToolTip.Tip="Measured GPU board power, averaged over the last second when supported. This is consumption, not the power limit." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Driver" Opacity="0.7" />
                        <TextBlock x:Name="GpuDriver" Text="UNKNOWN" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Temperature history" Classes="SubHeader" />
                    <avalonia:CartesianChart x:Name="TemperatureChart" Height="250" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
