<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.3"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3"/>
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-570"/>
        <PackageReference Include="Material.Icons" Version="3.0.2"/>
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2"/>
        <PackageReference Include="MessageBox.Avalonia" Version="12.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="display_config.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../LICENSE" Link="licenses/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../NOTICE.md" Link="licenses/NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../THIRD-PARTY-NOTICES.md" Link="licenses/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../LICENSES/**" Link="licenses/LICENSES/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\Fonts\OpenSans-SemiBold.ttf"/>
        <AvaloniaResource Include="Assets\Fonts\OpenSans.ttf"/>
        <AvaloniaResource Include="Assets\Fonts\Oxanium-Bold.ttf"/>
        <AvaloniaResource Include="Assets\Fonts\Oxanium.ttf"/>
        <None Remove="iconTransparent.png"/>
        <AvaloniaResource Include="iconTransparent.png"/>
        <None Remove="icon.png"/>
        <AvaloniaResource Include="icon.png"/>
        <None Remove="closeupTransparent.png"/>
        <AvaloniaResource Include="closeupTransparent.png"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Dashboard.axaml.cs">
            <DependentUpon>Dashboard.axaml</DependentUpon>
        </Compile>
        <Compile Update="InternalsManager.axaml.cs">
            <DependentUpon>InternalsManager.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
