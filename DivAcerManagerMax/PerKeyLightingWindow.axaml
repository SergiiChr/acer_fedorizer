<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DivAcerManagerMax.PerKeyLightingWindow" Title="Per-key keyboard lighting"
        Width="1120" Height="740" MinWidth="850" MinHeight="650" Background="#18181b"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
        <StackPanel Spacing="6">
            <TextBlock Text="Per-key keyboard lighting" Classes="SectionHeader" />
            <TextBlock Text="Select keys, choose a color, and paint the preview. Apply sends the complete static layout." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch">
            <Canvas x:Name="KeyboardCanvas" Width="1000" Height="320" />
        </Viewbox>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="24">
            <StackPanel Spacing="6">
                <ColorView x:Name="PaintColor" Color="#FF2300" Height="150" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorComponentsVisible="False" IsColorModelVisible="False" IsColorPaletteVisible="False" IsHexInputVisible="False" IsAccentColorsVisible="False" />
                <TextBox x:Name="PaintHex" Text="#FF2300" PlaceholderText="#RRGGBB" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock x:Name="SelectionInfo" Text="Loading keyboard layout…" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Select all" Click="SelectAll_Click" Margin="0,0,8,6" />
                    <Button Content="Clear selection" Click="ClearSelection_Click" Margin="0,0,8,6" />
                    <Button x:Name="PaintSelection" Content="Paint selection" Click="Paint_Click" Margin="0,0,0,6" />
                </WrapPanel>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Text="Brightness (%)" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" x:Name="KeyBrightness" Minimum="0" Maximum="100" Value="100" Increment="5" />
                </Grid>
                <Button x:Name="ApplyKeys" Content="Apply per-key colors" Click="Apply_Click" HorizontalAlignment="Stretch" IsEnabled="False" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="KeyResult" TextWrapping="Wrap" Text="Preview only. Applying replaces the keyboard's current effect." />
    </Grid>
</Window>
